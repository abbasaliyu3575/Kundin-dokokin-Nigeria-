<?xml version="1.0" encoding="UTF-8"?>
<lexicon version="1.0"
      xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.w3.org/2005/01/pronunciation-lexicon
        http://www.w3.org/TR/pronunciation-lexicon/pls.xsd"
      alphabet="ipa" xml:lang="yo">
  <!-- Lexicon for Alajah (28yrs) - Ibadan / Lagos Yoruba -->
  <lexeme>
    <grapheme>ṣe</grapheme>
    <phoneme>ʃe</phoneme>
    <alias>shey</alias>
  </lexeme>
  <lexeme>
    <grapheme>se</grapheme>
    <phoneme>ʃe</phoneme>
    <alias>shey</alias>
  </lexeme>
  <lexeme>
    <grapheme>ẹ</grapheme>
    <phoneme>ɛ</phoneme>
    <alias>eh</alias>
  </lexeme>
  <lexeme>
    <grapheme>ọ</grapheme>
    <phoneme>ɔ</phoneme>
    <alias>aw</alias>
  </lexeme>
  <lexeme>
    <grapheme>ọmọ</grapheme>
    <phoneme>ɔ.mɔ</phoneme>
    <alias>awmaw</alias>
  </lexeme>
  <lexeme>
    <grapheme>ọlọpa</grapheme>
    <phoneme>ɔ.lɔ.paː</phoneme>
    <alias>awlawpah</alias>
  </lexeme>
  <lexeme>
    <grapheme>gb</grapheme>
    <phoneme>ɡ͡b</phoneme>
    <alias>gb</alias>
  </lexeme>
</lexicon>
