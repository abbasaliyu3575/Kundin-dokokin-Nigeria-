<?xml version="1.0" encoding="UTF-8"?>
<lexicon version="1.0"
      xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.w3.org/2005/01/pronunciation-lexicon
        http://www.w3.org/TR/pronunciation-lexicon/pls.xsd"
      alphabet="ipa" xml:lang="ig">
  <!-- Lexicon for Ngozi (24yrs) - Owerri / Anambra Igbo -->
  <lexeme>
    <grapheme>ị</grapheme>
    <phoneme>ɪ</phoneme>
    <alias>ee</alias>
  </lexeme>
  <lexeme>
    <grapheme>ụ</grapheme>
    <phoneme>ʊ</phoneme>
    <alias>oo</alias>
  </lexeme>
  <lexeme>
    <grapheme>ọ</grapheme>
    <phoneme>ɔ</phoneme>
    <alias>aw</alias>
  </lexeme>
  <lexeme>
    <grapheme>nwanne</grapheme>
    <phoneme>ŋʷa.nːe</phoneme>
    <alias>nwahnneh</alias>
  </lexeme>
  <lexeme>
    <grapheme>onye</grapheme>
    <phoneme>o.ɲe</phoneme>
    <alias>onyeh</alias>
  </lexeme>
  <lexeme>
    <grapheme>ndị</grapheme>
    <phoneme>ⁿdiː</phoneme>
    <alias>ndee</alias>
  </lexeme>
  <lexeme>
    <grapheme>ọbụrụ</grapheme>
    <phoneme>ɔ.ɓʊ.ɾʊ</phoneme>
    <alias>awbooro</alias>
  </lexeme>
  <lexeme>
    <grapheme>ọrụ</grapheme>
    <phoneme>ɔ.ɾʊ</phoneme>
    <alias>awroo</alias>
  </lexeme>
  <lexeme>
    <grapheme>ọchịchị</grapheme>
    <phoneme>ɔ.t͡ʃɪ.t͡ʃɪ</phoneme>
    <alias>awcheechih</alias>
  </lexeme>
  <lexeme>
    <grapheme>mkpọrọ</grapheme>
    <phoneme>m̩.k͡pɔ.ɾɔ</phoneme>
    <alias>mkpawraw</alias>
  </lexeme>
</lexicon>
