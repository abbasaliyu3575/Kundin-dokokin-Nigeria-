      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.w3.org/2005/01/pronunciation-lexicon
        http://www.w3.org/TR/pronunciation-lexicon/pls.xsd"
      alphabet="ipa" xml:lang="ha">
  <!-- Lexicon for A'ishah 'Yar Kano (22yrs) - Northern Kano Hausa -->
  <lexeme>
    <grapheme>na</grapheme>
    <phoneme>naː</phoneme>
    <alias>nah</alias>
  </lexeme>
  <lexeme>
    <grapheme>ta</grapheme>
    <phoneme>taː</phoneme>
    <alias>tah</alias>
  </lexeme>
  <lexeme>
    <grapheme>ce</grapheme>
    <phoneme>t͡ʃeː</phoneme>
    <alias>che</alias>
  </lexeme>
  <lexeme>
    <grapheme>ci</grapheme>
    <phoneme>t͡ʃiː</phoneme>
    <alias>chi</alias>
  </lexeme>
  <lexeme>
    <grapheme>cikin</grapheme>
    <phoneme>t͡ʃi.kɪn</phoneme>
    <alias>chikin</alias>
  </lexeme>
  <lexeme>
    <grapheme>caji</grapheme>
    <phoneme>t͡ʃaː.d͡ʒiː</phoneme>
    <alias>chaji</alias>
  </lexeme>
  <lexeme>
    <grapheme>cin</grapheme>
    <phoneme>t͡ʃɪn</phoneme>
    <alias>chin</alias>
  </lexeme>
  <lexeme>
    <grapheme>cewa</grapheme>
    <phoneme>t͡ʃeː.waː</phoneme>
    <alias>chewa</alias>
  </lexeme>
  <lexeme>
    <grapheme>ƙ</grapheme>
    <phoneme>kʼ</phoneme>
    <alias>k</alias>
  </lexeme>
  <lexeme>
    <grapheme>ɓ</grapheme>
    <phoneme>ɓ</phoneme>
    <alias>b</alias>
  </lexeme>
  <lexeme>
    <grapheme>ɗ</grapheme>
    <phoneme>ɗ</phoneme>
    <alias>d</alias>
  </lexeme>
  <lexeme>
    <grapheme>ƴ</grapheme>
    <phoneme>ʔj</phoneme>
    <alias>'y</alias>
  </lexeme>
  <lexeme>
    <grapheme>'ya</grapheme>
